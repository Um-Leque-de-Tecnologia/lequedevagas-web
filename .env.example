# Copie para .env (o Prisma lê) e .env.local (o Next e o Auth.js leem).
# Nenhum dos dois vai para o Git.

# .env — aula 06
DATABASE_URL="file:./dev.db"

# .env.local — aula 07. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Só para o `npm start` na sua máquina (o build de produção).
AUTH_TRUST_HOST=true
