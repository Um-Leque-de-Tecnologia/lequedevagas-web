// O arquivo que descreve o banco inteiro. Um arquivo só, para as quatro
// frentes: cada model entrou com a frente que o escreveu, e cada mudança
// virou uma migration em prisma/migrations/ — que vai para o Git.

// O gerador do slide da aula 06: o cliente sai em node_modules, e todo
// arquivo importa de "@prisma/client". (O `prisma init` do 6.19 gera outro,
// com `output`; o seed.mjs e o lib/prisma.ts daqui dependem deste.)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // um arquivo no projeto: zero serviço para subir
  url      = env("DATABASE_URL")
}

// ─── frente 1 · aula 06 ─────────────────────────────────────────────────
model Vaga {
  id              String   @id @default(uuid())
  titulo          String
  empresa         String
  empresaSlug     String
  area            String
  senioridade     String
  local           String
  aceitaIniciante Boolean  @default(false)
  descricao       String
  criadaEm        DateTime @default(now()) // o banco carimba; ninguém manda

  // frente 4 · aula 06 — arquivar não apaga: marca.
  arquivada Boolean @default(false)

  // frente 1 · aula 07 — quem publicou. OPCIONAL: as vagas criadas antes
  // da aula 07 não têm dono, e a tabela precisa continuar aceitando essas
  // linhas. Vaga sem dono ninguém arquiva (PERMISSOES.md).
  autorId String?
  autor   Pessoa? @relation(fields: [autorId], references: [id])

  // frente 3 · aula 06 — o outro lado da relação
  candidaturas Candidatura[]
}

// ─── frente 2 · aula 06 ─────────────────────────────────────────────────
// O slug É a chave: é o que vai na URL e o que a Vaga guarda em empresaSlug.
// Só existe linha aqui para empresa editada pelo site — e aí ela vence a do
// dados/empresas.json (DADOS.md).
model Empresa {
  slug      String   @id
  nome      String
  sobre     String
  site      String
  editadaEm DateTime @updatedAt // o banco atualiza a cada gravação
}

// ─── frente 3 · aula 06 — a primeira relação do projeto ─────────────────
model Candidatura {
  id       String   @id @default(uuid())
  nome     String
  email    String
  // SQLite não tem lista: as habilidades vão juntas num texto, separadas
  // por vírgula. Só o lib/api.ts sabe disso.
  habilidades String  @default("")
  vagaId   String
  vaga     Vaga     @relation(fields: [vagaId], references: [id])
  criadaEm DateTime @default(now())

  // frente 3 · aula 07 — de quem é. Opcional pelo mesmo motivo do autorId.
  pessoaId String?
  pessoa   Pessoa? @relation(fields: [pessoaId], references: [id])
}

// ─── aula 07 · LAB 2 ────────────────────────────────────────────────────
enum Papel {
  candidata
  empresa
}

model Pessoa {
  id          String  @id @default(uuid())
  nome        String
  email       String  @unique // é o login: dois iguais não podem existir
  senhaHash   String // nunca a senha: o que o bcrypt devolveu
  papel       Papel   @default(candidata)
  empresaSlug String? // só quem é "empresa": por qual ela fala

  vagas        Vaga[] // frente 1 · aula 07
  candidaturas Candidatura[] // frente 3 · aula 07
}
